---
import PostCard from "../../components/PostCard.astro";
import Base from "../../layouts/Base.astro";
import { mediaUrl } from "../../lib/media";
import { categoryName, t } from "../../lib/messages";
import { getPosts } from "../../lib/posts";
import { CATEGORIES, SITE } from "../../site.config";

const posts = await getPosts();
const banner = posts[0] && mediaUrl(posts[0].id, posts[0].data.cover);
---

<Base title={t.blog.title} description={t.blog.intro}>
  <section class="banner" style={banner ? `--banner: url(${banner})` : undefined}>
    <div class="wrap">
      <h1>{t.blog.title}</h1>
      <p>{t.blog.intro}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap" data-blog data-page-size={SITE.postsPerPage}>
      <nav class="chips" aria-label="Categories">
        <a href="/blog.html" data-filter="" aria-current="true">{t.blog.all}</a>
        {CATEGORIES.map((c) => <a href={`/blog.html?category=${c}`} data-filter={c}>{categoryName(c)}</a>)}
      </nav>
      {posts.length === 0 && <p>{t.blog.empty}</p>}
      <div class="grid-3">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
      <div class="more">
        <button class="btn btn--ghost" data-more hidden>{t.blog.loadMore}</button>
      </div>
    </div>
  </section>
</Base>

<script>
  // Category filter (?category=slug) and "load more" paging. Without JS every
  // post is listed, so nothing is lost.
  const root = document.querySelector<HTMLElement>("[data-blog]")!;
  const cards = [...root.querySelectorAll<HTMLElement>(".card")];
  const more = root.querySelector<HTMLButtonElement>("[data-more]")!;
  const pageSize = Number(root.dataset.pageSize);
  let limit = pageSize;

  const render = () => {
    const filter = new URLSearchParams(location.search).get("category") ?? "";
    const matching = cards.filter((c) => !filter || c.dataset.category === filter);
    cards.forEach((c) => (c.hidden = true));
    matching.slice(0, limit).forEach((c) => (c.hidden = false));
    more.hidden = matching.length <= limit;
    root.querySelectorAll<HTMLAnchorElement>("[data-filter]").forEach((a) => {
      a.toggleAttribute("aria-current", a.dataset.filter === filter);
    });
  };

  root.querySelectorAll<HTMLAnchorElement>("[data-filter]").forEach((a) =>
    a.addEventListener("click", (e) => {
      e.preventDefault();
      history.replaceState(null, "", a.href);
      limit = pageSize;
      render();
    }),
  );
  more.addEventListener("click", () => {
    limit += pageSize;
    render();
  });
  render();
</script>

<style>
  .banner {
    display: flex;
    align-items: flex-end;
    min-height: clamp(240px, 34vw, 380px);
    padding-block: 40px;
    background:
      linear-gradient(to top, rgb(66 40 24 / 0.75), rgb(66 40 24 / 0.1)),
      var(--banner, linear-gradient(var(--brown), var(--brown))) center / cover;
    color: var(--cream);
  }
  .banner h1 {
    color: var(--cream);
    margin-bottom: 4px;
  }
  .banner p {
    margin: 0;
    max-width: 520px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 32px;
  }
  .chips a {
    padding: 0.5em 1em;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1.5px var(--line);
    color: var(--brown);
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
  }
  .chips a:hover {
    box-shadow: inset 0 0 0 1.5px var(--terracotta);
  }
  .chips a[aria-current] {
    background: var(--terracotta);
    box-shadow: none;
    color: #fff;
  }
  .more {
    display: flex;
    justify-content: center;
    margin-top: 40px;
  }
</style>
