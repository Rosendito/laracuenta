---
import ContactSection from "../components/ContactSection.astro";
import PostCard from "../components/PostCard.astro";
import Base from "../layouts/Base.astro";
import { mediaUrl } from "../lib/media";
import { t } from "../lib/messages";
import { getPosts } from "../lib/posts";

const posts = await getPosts();
const [featured] = posts;
const covers = posts.map((p) => ({ src: mediaUrl(p.id, p.data.cover), alt: p.data.coverAlt, href: `/blog/${p.id}.html` }));
// The about strip scatters six photos; repeat covers while there are fewer posts.
const scattered = covers.length ? Array.from({ length: 6 }, (_, i) => covers[i % covers.length]) : [];
---

<Base>
  <section class="section hero">
    <div class="wrap hero-grid">
      {
        featured && (
          <a class="hero-media" href={`/blog/${featured.id}.html`}>
            <img src={covers[0].src} alt={covers[0].alt} width="1200" height="840" />
          </a>
        )
      }
      <div class="hero-text">
        <h1>{t.hero.title}</h1>
        <p>{t.hero.text}</p>
        <a class="btn" href="/blog.html">{t.hero.cta}</a>
        {
          covers.length > 1 && (
            <div class="gallery" data-gallery>
              <button class="arrow" data-dir="-1" aria-label="Previous">‹</button>
              <ul>
                {covers.slice(1).map((c) => (
                  <li>
                    <a href={c.href}>
                      <img src={c.src} alt={c.alt} loading="lazy" width="200" height="200" />
                    </a>
                  </li>
                ))}
              </ul>
              <button class="arrow" data-dir="1" aria-label="Next">›</button>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <div class="section-head">
        <h2>{t.recent.title}</h2>
        <a href="/blog.html">{t.recent.seeAll} →</a>
      </div>
      <div class="grid-3">
        {posts.slice(0, 3).map((post) => <PostCard post={post} showButton />)}
      </div>
    </div>
  </section>

  <section class="section about">
    <div class="wrap about-grid">
      {
        scattered.slice(0, 3).map((c, i) => (
          <img class={`s s${i}`} src={c.src} alt="" loading="lazy" width="200" height="200" />
        ))
      }
      <div class="about-text">
        <h2>{t.about.title}</h2>
        <p>{t.about.text}</p>
        <a class="btn" href="/about.html">{t.about.cta}</a>
      </div>
      {
        scattered.slice(3).map((c, i) => (
          <img class={`s s${i + 3}`} src={c.src} alt="" loading="lazy" width="200" height="200" />
        ))
      }
    </div>
  </section>

  <div class="section--alt"><ContactSection /></div>
</Base>

<script>
  document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((gallery) => {
    const list = gallery.querySelector("ul")!;
    gallery.querySelectorAll<HTMLButtonElement>(".arrow").forEach((btn) =>
      btn.addEventListener("click", () =>
        list.scrollBy({ left: Number(btn.dataset.dir) * list.clientWidth, behavior: "smooth" }),
      ),
    );
  });
</script>

<style>
  .hero-grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: clamp(28px, 5vw, 56px);
    align-items: center;
  }
  .hero-media img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .hero-text p {
    font-size: 1.08rem;
    margin-bottom: 24px;
  }
  .gallery {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 36px;
  }
  .gallery ul {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 3 * 10px) / 4);
    gap: 10px;
    flex: 1;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .gallery li {
    scroll-snap-align: start;
  }
  .gallery img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 4px;
  }
  .arrow {
    border: 0;
    background: none;
    color: var(--brown);
    font-size: 1.8rem;
    line-height: 1;
    cursor: pointer;
  }
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 3fr 1fr 1fr;
    grid-template-rows: repeat(3, auto);
    gap: 16px;
    align-items: center;
  }
  .about-text {
    grid-column: 3;
    grid-row: 1 / 4;
    text-align: center;
    padding-inline: 24px;
  }
  .s {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 4px;
  }
  .s0 { grid-area: 1 / 1; }
  .s1 { grid-area: 2 / 2; }
  .s2 { grid-area: 3 / 1; }
  .s3 { grid-area: 1 / 5; }
  .s4 { grid-area: 2 / 4; }
  .s5 { grid-area: 3 / 5; }
  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .about-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .about-text {
      grid-column: 1 / -1;
      grid-row: 1;
      padding: 0 0 16px;
    }
    .s {
      grid-area: auto;
    }
  }
</style>
