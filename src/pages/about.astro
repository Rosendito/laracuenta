---
import Base from "../layouts/Base.astro";
import { categoryName, t } from "../lib/messages";
import { CATEGORIES } from "../site.config";
---

<Base title={t.about.title} description={t.about.text}>
  <section class="section">
    <div class="wrap about">
      <img src="/laracuenta-isotipo.svg" alt="" width="120" height="108" />
      <h1>{t.about.title}</h1>
      <p class="lead">{t.about.text}</p>
      <p>{t.about.body}</p>
      <ul>
        {
          CATEGORIES.map((c) => (
            <li>
              <a class="tag" href={`/blog.html?category=${c}`}>{categoryName(c)}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .about {
    max-width: var(--read);
    text-align: center;
  }
  .about img {
    margin: 0 auto 24px;
  }
  .lead {
    font-size: 1.2rem;
    color: var(--brown);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 24px;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }
</style>
