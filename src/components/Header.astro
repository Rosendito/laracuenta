---
import { t } from "../lib/messages";
import SocialIcons from "./SocialIcons.astro";

const path = Astro.url.pathname;
const items = [
  { href: "/", label: t.nav.home, active: path === "/" },
  { href: "/blog.html", label: t.nav.blog, active: path.startsWith("/blog") },
  { href: "/about.html", label: t.nav.about, active: path.startsWith("/about") },
  { href: "/contact.html", label: t.nav.contact, active: path.startsWith("/contact") },
];
---

<header class="header">
  <div class="wrap bar">
    <a href="/" class="logo"><img src="/laracuenta-logo.svg" alt={t.siteName} width="170" height="56" /></a>
    <nav aria-label="Main">
      <ul>
        {
          items.map((item) => (
            <li>
              <a href={item.href} aria-current={item.active ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="social-slot"><SocialIcons /></div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--cream) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 76px;
  }
  .logo img {
    width: 150px;
    height: auto;
  }
  ul {
    display: flex;
    gap: clamp(14px, 3vw, 36px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    padding-block: 6px;
    color: var(--brown);
    font-weight: 500;
    font-size: 0.92rem;
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }
  nav a:hover {
    color: var(--orange);
  }
  nav a[aria-current="page"] {
    border-color: var(--orange);
    color: var(--orange);
  }
  @media (max-width: 760px) {
    .bar {
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px 24px;
      padding-block: 12px;
    }
    .social-slot {
      display: none;
    }
    .logo img {
      width: 120px;
    }
  }
</style>
