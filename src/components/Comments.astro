---
import { strings } from "../config/strings";
import { commentAvatarStack, commentsMockup } from "../data/comments-mockup";
import Avatar from "./Avatar.astro";
import Button from "./Button.astro";

const count = commentsMockup.length;
---

<section class="comments" aria-labelledby="comments-title">
  <div class="comments__head">
    <h2 id="comments-title">
      {strings.comments.title}{" "}
      <span>
        (<span data-comment-count>{count}</span>)
      </span>
    </h2>
    <div class="avatar-stack" aria-hidden="true">
      {commentAvatarStack.map((avatar) => (
        <Avatar initials={avatar.initials} tone={avatar.tone} />
      ))}
    </div>
  </div>

  <p class="comments__note">{strings.comments.sampleNote}</p>

  <ul class="comment-list">
    {commentsMockup.map((comment) => (
      <li class:list={["comment", comment.byAuthor && "comment--reply"]}>
        <Avatar initials={comment.initials} tone={comment.tone} />
        <div class="comment__bubble">
          <div class="comment__meta">
            <strong>{comment.author}</strong>
            {comment.byAuthor && <span class="badge">{strings.comments.authorBadge}</span>}
            <span>{comment.time}</span>
          </div>
          <p>{comment.text}</p>
          <div class="comment__actions">
            <button type="button">{strings.comments.reply}</button>
            <button type="button">{strings.comments.like(comment.likes)}</button>
          </div>
        </div>
      </li>
    ))}
  </ul>

  <form class="comment-form" action="#" method="post">
    <Avatar initials="?" tone="none" />
    <div class="comment-form__box">
      <label class="visually-hidden" for="comentario">
        {strings.comments.label}
      </label>
      <textarea
        id="comentario"
        name="comentario"
        placeholder={strings.comments.placeholder}
        required
      ></textarea>
      <div class="comment-form__row">
        <small>{strings.comments.moderation}</small>
        <Button type="submit" icon="send">
          {strings.comments.submit}{" "}
        </Button>
      </div>
    </div>
  </form>
</section>

<script>
  // Static mockup: submitting appends a pending comment to the list in the browser.
  import { strings } from "../config/strings";

  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const form = document.querySelector<HTMLFormElement>(".comment-form");
  const textarea = form?.querySelector<HTMLTextAreaElement>("textarea");
  const list = document.querySelector<HTMLUListElement>(".comment-list");
  const counter = document.querySelector<HTMLElement>("[data-comment-count]");

  if (form && textarea && list) {
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const text = textarea.value.trim();
      if (!text) {
        textarea.focus();
        return;
      }

      const item = document.createElement("li");
      item.className = "comment comment--mine";

      const avatar = document.createElement("div");
      avatar.className = "avatar avatar--sun";
      avatar.setAttribute("aria-hidden", "true");
      avatar.textContent = strings.comments.you;

      const bubble = document.createElement("div");
      bubble.className = "comment__bubble";

      const meta = document.createElement("div");
      meta.className = "comment__meta";
      const author = document.createElement("strong");
      author.textContent = strings.comments.you;
      const time = document.createElement("span");
      time.textContent = strings.comments.now;
      const badge = document.createElement("span");
      badge.className = "badge";
      badge.textContent = strings.comments.pending;
      meta.append(author, time, badge);

      const paragraph = document.createElement("p");
      paragraph.textContent = text;

      bubble.append(meta, paragraph);
      item.append(avatar, bubble);
      list.appendChild(item);

      textarea.value = "";
      if (counter) counter.textContent = String(list.querySelectorAll("li").length);
      item.scrollIntoView({ behavior: reducedMotion ? "auto" : "smooth", block: "nearest" });
    });
  }
</script>
