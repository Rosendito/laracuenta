---
// Renders every Markdown image in a story: a speech-bubble photo and an optional caption.
import { figureSizes } from "./sizes";
import type { ImageMetadata } from "astro";
import PhotoBubble from "../PhotoBubble.astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Markdown image title, used as the caption. */
  title?: string;
}

const { src, alt, title } = Astro.props;
---

<figure class="article__figure">
  <PhotoBubble src={src} alt={alt} sizes={figureSizes} widths={[700, 1400]} />
  {title && <figcaption>{title}</figcaption>}
</figure>
