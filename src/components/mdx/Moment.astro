---
// One entry of a Timeline. MDX may already wrap the text in <p>; exactly one is kept.
interface Props {
  date: string;
  /** Machine-readable value for <time>; defaults to the visible date. */
  datetime?: string;
}

const { date, datetime = date } = Astro.props;

const text = (await Astro.slots.render("default")).trim();
const paragraph = text.startsWith("<p") ? text : `<p>${text}</p>`;
---

<li>
  <time datetime={datetime}>{date}</time>
  <Fragment set:html={paragraph} />
</li>
