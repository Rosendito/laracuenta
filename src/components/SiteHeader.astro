---
import Icon from "./Icon.astro";
import SocialLinks from "./SocialLinks.astro";
import { site, type NavId } from "../config/site";
import { strings } from "../config/strings";
import { archiveHref, collectionList } from "../data/collections";

interface Props {
  /** Nav entry of the current page, marked with aria-current. */
  current?: NavId;
}

const { current } = Astro.props;
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="/" aria-label={strings.homeLabel}>
      <img src="/laracuenta-logo.svg" alt={site.name} width="200" height="96" />
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-principal">
      <span class="visually-hidden">{strings.menu}</span>
      <Icon name="menu" class="icon--open" />
      <Icon name="close" class="icon--close" />
    </button>

    <nav class="site-nav" id="nav-principal" aria-label={strings.mainNav}>
      <ul class="site-nav__list">
        {site.nav.map((item) => (
          <li>
            <a href={item.href} aria-current={item.id === current ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <!-- Mobile menu only: shortcuts to the four collections. -->
      <div class="site-nav__collections">
        <span class="eyebrow" id="nav-collections-label">
          {strings.menuCollections}
        </span>
        <ul aria-labelledby="nav-collections-label">
          {collectionList.map((collection) => (
            <li>
              <a class={`col-${collection.id}`} href={archiveHref(collection.id)}>
                {collection.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <SocialLinks />
    </nav>

    <SocialLinks />
  </div>
</header>

<script>
  /* Mobile nav: toggles the menu and closes it with Escape. */
  const navToggle = document.querySelector<HTMLButtonElement>(".nav-toggle");
  const nav = document.querySelector<HTMLElement>("#nav-principal");

  if (navToggle && nav) {
    // While the menu is open, the page behind it is out of reach (focus, clicks, screen readers).
    const behind = Array.from(document.querySelectorAll<HTMLElement>("main, .site-footer"));

    const setOpen = (open: boolean) => {
      navToggle.setAttribute("aria-expanded", String(open));
      nav.classList.toggle("is-open", open);
      behind.forEach((el) => (el.inert = open));
    };

    navToggle.addEventListener("click", () =>
      setOpen(navToggle.getAttribute("aria-expanded") !== "true"),
    );

    // Close the mobile menu after picking a link (anchors on the same page)
    nav
      .querySelectorAll("a")
      .forEach((link) => link.addEventListener("click", () => setOpen(false)));

    // Growing past the mobile layout closes the menu, so nothing stays inert.
    window
      .matchMedia("(min-width: 861px)")
      .addEventListener("change", (event) => event.matches && setOpen(false));

    // Home: mark the item of the section in view (Nosotros, Contacto), Inicio otherwise.
    if (location.pathname === "/") {
      const home = nav.querySelector<HTMLAnchorElement>('a[href="/"]');
      const spots = Array.from(nav.querySelectorAll<HTMLAnchorElement>('a[href^="/#"]')).flatMap(
        (link) => {
          const section = document.getElementById(link.hash.slice(1));
          return section ? [{ link, section }] : [];
        },
      );

      if (home && spots.length) {
        const update = () => {
          const line = window.innerHeight * 0.4;
          const atBottom =
            window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
          let active = home;
          for (const { link, section } of spots) {
            if (section.getBoundingClientRect().top <= line) active = link;
          }
          if (atBottom) active = spots[spots.length - 1].link;
          for (const link of [home, ...spots.map((spot) => spot.link)]) {
            if (link === active)
              link.setAttribute("aria-current", link === home ? "page" : "location");
            else link.removeAttribute("aria-current");
          }
        };

        let queued = false;
        window.addEventListener(
          "scroll",
          () => {
            if (queued) return;
            queued = true;
            requestAnimationFrame(() => {
              queued = false;
              update();
            });
          },
          { passive: true },
        );
        update();
      }
    }

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && nav.classList.contains("is-open")) {
        setOpen(false);
        navToggle.focus();
      }
    });
  }
</script>
