---
import { t } from "../lib/messages";
import { SITE } from "../site.config";

interface Props {
  heading?: "h1" | "h2";
}

const { heading: Heading = "h2" } = Astro.props;
---

<section class="section" id="contact">
  <div class="wrap split">
    <div class="intro">
      <Heading>{t.contact.title}</Heading>
      <p>{t.contact.text}</p>
      <p class="mail">
        <img src="/laracuenta-isotipo.svg" alt="" width="56" height="50" />
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </p>
    </div>
    {
      SITE.contactFormEndpoint ? (
        <form class="form" action={SITE.contactFormEndpoint} method="post">
          <div class="pair">
            <label>
              <span class="visually-hidden">{t.contact.firstName}</span>
              <input name="firstName" placeholder={t.contact.firstName} required />
            </label>
            <label>
              <span class="visually-hidden">{t.contact.lastName}</span>
              <input name="lastName" placeholder={t.contact.lastName} />
            </label>
          </div>
          <label>
            <span class="visually-hidden">{t.contact.email}</span>
            <input type="email" name="email" placeholder={t.contact.email} required />
          </label>
          <label>
            <span class="visually-hidden">{t.contact.subject}</span>
            <input name="subject" placeholder={t.contact.subject} />
          </label>
          <label>
            <span class="visually-hidden">{t.contact.message}</span>
            <textarea name="message" rows="5" placeholder={t.contact.message} required />
          </label>
          <button class="btn">{t.contact.send}</button>
        </form>
      ) : (
        <div class="fallback">
          <a class="btn" href={`mailto:${SITE.email}`}>
            {t.contact.mailto}
          </a>
        </div>
      )
    }
  </div>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
  }
  .intro {
    padding-right: 48px;
    border-right: 1px solid var(--line);
  }
  .mail {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 28px;
  }
  .form {
    display: grid;
    gap: 12px;
  }
  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .form .btn {
    width: 100%;
  }
  .fallback {
    display: grid;
    place-items: center;
  }
  @media (max-width: 760px) {
    .split {
      grid-template-columns: 1fr;
    }
    .intro {
      padding-right: 0;
      border-right: 0;
    }
  }
</style>
