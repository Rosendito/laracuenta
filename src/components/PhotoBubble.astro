---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  widths?: number[];
  sizes?: string;
  loading?: "lazy" | "eager";
}

const {
  src,
  alt,
  widths = [400, 800, 1200],
  sizes = "(max-width: 700px) 78vw, 400px",
  loading = "lazy",
} = Astro.props;
---

<div class="photo-bubble">
  <Image src={src} alt={alt} widths={widths} sizes={sizes} loading={loading} />
</div>
