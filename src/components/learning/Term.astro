---
// A glossary term inside running text: hover, focus or tap shows its definition in a
// floating card. Screen readers get the same definition through aria-describedby,
// which points at the glossary annex on the page (see GlossaryList.astro).
import { seoGlossary, type GlossaryKey } from "../../data/seo-glossary";

interface Props {
  k: GlossaryKey;
}

const { k } = Astro.props;
const entry = seoGlossary[k];
---

<button
  class="term"
  type="button"
  aria-describedby={`glosario-${k}`}
  data-term={entry.term}
  data-definition={entry.definition}
>
  <slot>{entry.term}</slot>
</button>

<script>
  const gap = 8;
  let tip: HTMLElement | null = null;
  let open: HTMLElement | null = null;

  const hide = () => {
    tip?.setAttribute("hidden", "");
    open = null;
  };

  // below the term, or above when it does not fit; never past the screen edges
  const place = () => {
    if (!tip || !open) return;
    const box = open.getBoundingClientRect();
    const { offsetWidth: width, offsetHeight: height } = tip;
    const left = Math.min(
      Math.max(gap, box.left + box.width / 2 - width / 2),
      innerWidth - width - gap,
    );
    const below = box.bottom + gap;
    const top = below + height > innerHeight - gap ? box.top - gap - height : below;
    tip.style.left = `${left}px`;
    tip.style.top = `${Math.max(gap, top)}px`;
  };

  const show = (term: HTMLElement) => {
    if (!tip) {
      tip = document.createElement("div");
      tip.className = "term-tip";
      tip.setAttribute("aria-hidden", "true");
      document.body.append(tip);
    }
    const name = document.createElement("strong");
    name.textContent = term.dataset.term!;
    const text = document.createElement("span");
    text.textContent = term.dataset.definition!;
    tip.replaceChildren(name, text);
    tip.removeAttribute("hidden");
    open = term;
    place();
  };

  for (const term of document.querySelectorAll<HTMLElement>(".term[data-term]")) {
    term.addEventListener("pointerenter", (e) => e.pointerType === "mouse" && show(term));
    term.addEventListener("pointerleave", (e) => e.pointerType === "mouse" && hide());
    term.addEventListener("focus", () => show(term));
    term.addEventListener("blur", hide);
    // a tap focuses the term in most browsers, but not in Safari; a tap elsewhere closes it
    term.addEventListener("click", () => show(term));
  }

  document.addEventListener("keydown", (e) => e.key === "Escape" && hide());
  document.addEventListener("pointerdown", (e) => {
    if (!(e.target as Element).closest(".term")) hide();
  });
  addEventListener("scroll", place, { passive: true });
  addEventListener("resize", place);
</script>
