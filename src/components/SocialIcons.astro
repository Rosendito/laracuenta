---
import { SITE } from "../site.config";

const icons: Record<string, string> = {
  instagram:
    "M12 2.2c3.2 0 3.6 0 4.8.1 3.3.1 4.8 1.7 4.9 4.9.1 1.3.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 3.2-1.7 4.8-4.9 4.9-1.3.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-3.3-.1-4.8-1.7-4.9-4.9C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8C2.4 3.9 3.9 2.4 7.2 2.3 8.4 2.2 8.8 2.2 12 2.2zm0 4.7a5.1 5.1 0 1 0 0 10.2 5.1 5.1 0 0 0 0-10.2zm0 8.4a3.3 3.3 0 1 1 0-6.6 3.3 3.3 0 0 1 0 6.6zm5.3-9.8a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4z",
  facebook:
    "M14 8V6.1c0-.9.2-1.3 1.6-1.3H18V1.5h-3.3C11.2 1.5 10 3.1 10 6v2H7.5v3.3H10V22h4V11.3h3l.4-3.3H14z",
  tiktok:
    "M16.6 2h-3.4v13.4a2.9 2.9 0 1 1-2-2.8V9.1a6.3 6.3 0 1 0 5.4 6.3V8.6a7.7 7.7 0 0 0 4.4 1.4V6.6a4.4 4.4 0 0 1-4.4-4.6z",
  x: "M17.8 2.5h3.3l-7.2 8.2 8.5 10.8h-6.6l-5.2-6.8-6 6.8H1.3l7.7-8.8L.9 2.5h6.8l4.7 6.2 5.4-6.2zm-1.2 17.1h1.8L7.5 4.3H5.5l11.1 15.3z",
};

const links = Object.entries(SITE.social).filter(([, url]) => url);
---

{
  links.length > 0 && (
    <ul class="social">
      {links.map(([name, url]) => (
        <li>
          <a href={url} aria-label={name} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path d={icons[name]} fill="currentColor" />
            </svg>
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .social {
    display: flex;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  a {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.5px currentColor;
    color: var(--brown);
    transition: background 0.15s, color 0.15s;
  }
  a:hover {
    background: var(--orange);
    box-shadow: none;
    color: #fff;
  }
</style>
